{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "backend",
  "description": "What the app's TypeScript backend may do in every window: talk to the user's Redmine server and open links.",
  "windows": ["main", "view-*"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    },
    "credential-vault:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
