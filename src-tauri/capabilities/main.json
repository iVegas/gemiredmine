{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What every channel's main window may do: talk to the user's Redmine server and open links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
